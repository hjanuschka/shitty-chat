# Copy to .env, edit, then `docker compose up -d`.

# ---- deployment ----

# For a real deployment: your public domain. Caddy auto-fetches Let's
# Encrypt certs for it.
# For a quick IP-only test on a VM without DNS: use `:80` to serve
# plain http/ws with no TLS.
DOMAIN=shitty.chat

# Address Let's Encrypt uses for ACME registration (only when DOMAIN is
# a real hostname).
ADMIN_EMAIL=you@example.com

# ---- auth ----

# Google OAuth 2.0 client (Web application) - create one at
# https://console.cloud.google.com/apis/credentials
# Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Set to "1" to enable a "dev login" button (creates a throwaway user).
# NEVER enable this in production.
DEV_LOGIN=0

# ---- abuse limits (defaults in parens) ----

# SC_ROOMS_PER_ACCOUNT=10
# SC_AGENTS_PER_ROOM=10
# SC_ASKS_PER_DAY=500
# SC_ASKS_PER_MINUTE=30
# SC_EMPTY_ROOM_TTL_MS=1200000       # 20 minutes
# SC_REAPER_INTERVAL_MS=60000        # 1 minute
